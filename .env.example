COMPOSE_PROJECT_NAME=musaed
POSTGRES_DB=musaed
POSTGRES_USER=musaed
POSTGRES_PASSWORD=change-me
# Development-only key; generate a unique persistent key for production.
APP_KEY=base64:R3S9rJTW6PFWOQTuFjP3sZkrz5qy/Wu8rbxMHEya4K0=
APP_NAME=Musaed
LITELLM_MASTER_KEY=sk-local-development-only
LITELLM_SALT_KEY=change-me-too
AGENT_RUN_ROOT=/var/lib/musaed/runs
LITELLM_URL=http://litellm:4000
# Optional: set DEEPSEEK_API_KEY in your environment to enable DeepSeek as the default model.
# Generate the envelope keypair with:
#   php apps/web/artisan musaed:generate-envelope-keypair --write
# Keep the private key only in Laravel.
# The public key is injected into the agent runtime.
AGENT_ENVELOPE_PRIVATE_KEY=
AGENT_ENVELOPE_PUBLIC_KEY=
AGENT_ENVELOPE_CLOCK_SKEW_SECONDS=30
RUN_ENVELOPE_LIFETIME_SECONDS=300
